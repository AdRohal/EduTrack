<Window Style="{StaticResource {x:Type Window}}" x:Class="EduTrack.ScreenLoading"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:EduTrack.Utilities"
        Title="EduTrack" Width="560" Height="340" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource SidebarBrush}">
    <Grid>
        <Grid.Background>
            <DrawingBrush TileMode="Tile" Viewport="0,0,100,34" ViewportUnits="Absolute" Viewbox="0,0,100,34" ViewboxUnits="Absolute">
                <DrawingBrush.Drawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="{DynamicResource SidebarLineBrush}" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <LineGeometry StartPoint="0,33.5" EndPoint="100,33.5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Grid.Background>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <u:LogoMark Width="76" Height="76" Foreground="{DynamicResource SidebarInkBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="EduTrack" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource SidebarInkBrush}"
                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
            <TextBlock x:Name="StatusText" Text="Connecting to the database" FontSize="14" Foreground="{DynamicResource SidebarMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <ProgressBar x:Name="progressBar" Width="240" Margin="0,24,0,0" Maximum="100"/>
            <StackPanel x:Name="FailurePanel" Visibility="Collapsed" Margin="0,22,0,0" HorizontalAlignment="Center">
                <TextBlock x:Name="FailureText" Foreground="{DynamicResource SidebarInkBrush}" TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="400" LineHeight="20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Content="Try again" Style="{StaticResource PrimaryButton}" Click="Retry_Click" Margin="0,0,10,0"/>
                    <Button Content="Open anyway" Style="{StaticResource GhostButton}" Foreground="{DynamicResource SidebarInkBrush}" Click="OpenAnyway_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Click="Close_Click"
                Foreground="{DynamicResource SidebarMutedBrush}" ToolTip="Close" Width="34" MinHeight="34" Padding="0">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"/>
        </Button>
    </Grid>
</Window>

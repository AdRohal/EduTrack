<UserControl x:Class="EduTrack.Utilities.Avatar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:EduTrack.Utilities"
             Width="40" Height="40" Focusable="False" IsTabStop="False">
    <UserControl.Resources>
        <u:PhotoBrushConverter x:Key="PhotoBrush"/>
    </UserControl.Resources>
    <Grid>
        <Ellipse Fill="{DynamicResource PrimarySoftBrush}"/>
        <TextBlock x:Name="InitialsText" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryBrush}"/>
        <Ellipse x:Name="PhotoEllipse"/>
    </Grid>
</UserControl>

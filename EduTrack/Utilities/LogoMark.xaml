<UserControl x:Class="EduTrack.Utilities.LogoMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="40" Height="40" Focusable="False" IsHitTestVisible="False">
    <!-- The EduTrack "E": a spine and three rounded bars. The middle bar is the chalk-yellow track mark. -->
    <Viewbox>
        <Canvas Width="100" Height="100">
            <Rectangle Canvas.Left="12" Canvas.Top="8" Width="24" Height="84" RadiusX="12" RadiusY="12"
                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" Opacity="0.55"/>
            <Rectangle Canvas.Left="12" Canvas.Top="8" Width="78" Height="24" RadiusX="12" RadiusY="12"
                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Rectangle Canvas.Left="12" Canvas.Top="38" Width="78" Height="24" RadiusX="12" RadiusY="12"
                       Fill="{DynamicResource AccentBrush}"/>
            <Rectangle Canvas.Left="12" Canvas.Top="68" Width="78" Height="24" RadiusX="12" RadiusY="12"
                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Canvas>
    </Viewbox>
</UserControl>

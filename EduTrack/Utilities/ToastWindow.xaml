<Window Style="{StaticResource {x:Type Window}}" x:Class="EduTrack.Utilities.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" SizeToContent="WidthAndHeight" ResizeMode="NoResize" Focusable="False" IsHitTestVisible="False">
    <Border Margin="20" Padding="18,12" CornerRadius="12" Background="{DynamicResource InkBrush}" MaxWidth="460">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center">
                <Path Data="M5,11 L9,15 L16,7" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="22" Height="22"/>
            </Border>
            <TextBlock x:Name="Message" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource BgBrush}"
                       FontWeight="Bold" TextWrapping="Wrap" MaxWidth="380"/>
        </StackPanel>
    </Border>
</Window>

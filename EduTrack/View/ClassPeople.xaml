<UserControl x:Class="EduTrack.View.ClassPeople"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:EduTrack.Utilities">
    <UserControl.Resources>
        <u:DashIfEmptyConverter x:Key="Dash"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Add someone -->
        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MaxWidth="440"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <RadioButton x:Name="radioStudent" Content="A student" IsChecked="True" Style="{StaticResource TabButton}" GroupName="AddKind" Margin="0,0,18,0" Checked="AddKind_Changed"/>
                    <RadioButton x:Name="radioTeacher" Content="A teacher" Style="{StaticResource TabButton}" GroupName="AddKind" Margin="0,0,0,0" Checked="AddKind_Changed"/>
                </StackPanel>
                <ComboBox x:Name="comboBox" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" Tag="Choose who to add">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="{Binding Note}" Foreground="{DynamicResource FaintBrush}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Content="Add to class" Style="{StaticResource PrimaryButton}" Click="Add_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="400"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="TeachersHeader" Text="Teachers" Style="{StaticResource SectionText}" Margin="20,14,20,10" VerticalAlignment="Center" MinHeight="34"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl x:Name="TeachersList" Margin="8,0,8,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Margin="12,7">
                                                <u:Avatar Photo="{Binding P_Pic}" Initials="{Binding Initials}" Width="36" Height="36"/>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Email, Converter={StaticResource Dash}}" Style="{StaticResource CaptionText}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="RemoveTeacher_Click" ToolTip="Remove from this class" Margin="0,0,8,0">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="TeachersEmpty" Text="No teacher has been assigned to this class yet." Style="{StaticResource MutedText}"
                                       Margin="20,4,20,0" Visibility="Collapsed"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="20,14,20,10">
                        <TextBlock x:Name="StudentsHeader" Text="Students" Style="{StaticResource SectionText}" VerticalAlignment="Center"/>
                        <Grid HorizontalAlignment="Right" Width="260">
                            <TextBox x:Name="SearchBox" Padding="38,0,12,0" Tag="Search this class" TextChanged="SearchBox_TextChanged" MinHeight="34"/>
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconSearch}" TextElement.Foreground="{DynamicResource FaintBrush}" Margin="11,0,0,0"
                                  VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl x:Name="StudentsList" Margin="8,0,8,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Margin="12,7">
                                                <u:Avatar Photo="{Binding P_Pic}" Initials="{Binding Initials}" Width="36" Height="36"/>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Email, Converter={StaticResource Dash}}" Style="{StaticResource CaptionText}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="RemoveStudent_Click" ToolTip="Remove from this class" Margin="0,0,8,0">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="StudentsEmpty" Style="{StaticResource MutedText}" Margin="20,4,20,0" Visibility="Collapsed"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

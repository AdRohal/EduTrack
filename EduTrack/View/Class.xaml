<UserControl x:Class="EduTrack.View.Class"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Classes" Style="{StaticResource DisplayText}"/>
            <TextBlock Text="Groups of students: who teaches them, when they meet and how they are graded." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabList" Content="All classes" Style="{StaticResource TabButton}" GroupName="ClassTabs" Margin="0,0,28,-1" Checked="Btn_Checked_1"/>
                    <RadioButton x:Name="TabNew" Content="New class" Style="{StaticResource TabButton}" GroupName="ClassTabs" Margin="0,0,28,-1" Checked="Btn_Checked"/>
                    <RadioButton x:Name="TabSchedule" Content="Schedule" Style="{StaticResource TabButton}" GroupName="ClassTabs" Margin="0,0,28,-1" Checked="Btn_Checked_2"/>
                    <RadioButton x:Name="TabGrades" Content="Grades" Style="{StaticResource TabButton}" GroupName="ClassTabs" Margin="0,0,28,-1" Checked="Btn_Checked_3"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <ContentControl x:Name="Pages" Grid.Row="1" Margin="0,20,0,0" IsTabStop="False"/>
    </Grid>
</UserControl>

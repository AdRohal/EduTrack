<UserControl x:Class="EduTrack.View.ClassTimetable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Pick a lesson to change it, or add a new one. Attendance follows this timetable." Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Add lesson" Style="{StaticResource PrimaryButton}" Click="AddLesson_Click"/>
        </Grid>

        <!-- Lesson editor -->
        <Border x:Name="Editor" Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="EditorTitle" Text="New lesson" Style="{StaticResource SectionText}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Day" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DayBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="From" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="StartBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="To" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="EndBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Module" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ModuleBox" DisplayMemberPath="ModuleName" Tag="No module"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Title (when there is no module)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TitleBox" MaxLength="100" Tag="e.g. Project work"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Room" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="RoomBox" MaxLength="50" Tag="e.g. A2"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="EditorMessage" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="DeleteButton" Content="Delete lesson" Click="DeleteLesson_Click" Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" Margin="0,0,10,0"/>
                        <Button Content="Cancel" Click="CancelEdit_Click" Margin="0,0,10,0"/>
                        <Button Content="Save lesson" Style="{StaticResource PrimaryButton}" Click="SaveLesson_Click" MinWidth="130"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- The week -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="WeekGrid" Margin="12"/>
                </ScrollViewer>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock Text="No lesson planned yet" Style="{StaticResource SectionText}" TextAlignment="Center"/>
                    <TextBlock Text="Add the lessons of the week. Each one can be tied to a module, and its teacher follows." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="EduTrack.View.ClassOverview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FigureValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The numbers that matter, in one strip -->
        <Border Style="{StaticResource Card}" Padding="8,12" Margin="0,0,0,16">
            <UniformGrid Columns="5">
                <StackPanel Margin="14,0">
                    <TextBlock x:Name="StudentsValue" Text="–" Style="{StaticResource FigureValue}"/>
                    <TextBlock Text="Students" Style="{StaticResource CaptionText}"/>
                </StackPanel>
                <StackPanel Margin="14,0">
                    <TextBlock x:Name="TeachersValue" Text="–" Style="{StaticResource FigureValue}"/>
                    <TextBlock Text="Teachers" Style="{StaticResource CaptionText}"/>
                </StackPanel>
                <StackPanel Margin="14,0">
                    <TextBlock x:Name="ModulesValue" Text="–" Style="{StaticResource FigureValue}"/>
                    <TextBlock Text="Modules" Style="{StaticResource CaptionText}"/>
                </StackPanel>
                <StackPanel Margin="14,0">
                    <TextBlock x:Name="AttendanceValue" Text="–" Style="{StaticResource FigureValue}"/>
                    <TextBlock Text="Attendance, last 30 days" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Margin="14,0">
                    <TextBlock x:Name="AverageValue" Text="–" Style="{StaticResource FigureValue}"/>
                    <TextBlock Text="Class average" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Today -->
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="20,16,20,10">
                        <TextBlock Text="Today's lessons" Style="{StaticResource SectionText}"/>
                        <TextBlock x:Name="TodayDate" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl x:Name="TodayList" Margin="8,0,8,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" FontWeight="Bold" VerticalAlignment="Center" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding TeacherName}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="{Binding ActionText}" Click="TakeAttendance_Click" MinHeight="32" Padding="14,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel x:Name="TodayEmpty" Margin="20,4,20,0" Visibility="Collapsed">
                                <TextBlock Text="No lesson is planned for today." Style="{StaticResource MutedText}"/>
                                <Button Content="Take attendance anyway" Click="TakeAttendanceAnyway_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Needs attention -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="20,16,20,10">
                        <TextBlock Text="Needs attention" Style="{StaticResource SectionText}"/>
                        <TextBlock Text="From the last 30 days" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl x:Name="AttentionList" Margin="8,0,8,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding ActionText}" Click="Attention_Click" MinHeight="32" Padding="14,0" Style="{StaticResource GhostButton}"
                                                    Foreground="{DynamicResource PrimaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="AttentionEmpty" Text="Nothing needs attention. Attendance and grades are up to date." Style="{StaticResource MutedText}"
                                       Margin="20,4,20,0" Visibility="Collapsed"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    
        <!-- Who teaches what -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Modules" Style="{StaticResource SectionText}" Margin="20,16,20,6"/>
                <Grid Grid.Row="1" Margin="28,4,28,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Module" Style="{StaticResource CaptionText}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="Teacher" Style="{StaticResource CaptionText}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="Coefficient" Style="{StaticResource CaptionText}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="Assessments" Style="{StaticResource CaptionText}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="4" Text="Class average" Style="{StaticResource CaptionText}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <ItemsControl x:Name="ModulesList" Margin="8,0,8,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="20,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Teacher}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Coefficient}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Assessments}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Average}" FontWeight="Bold"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="ModulesEmpty" Margin="20,4,20,0" Visibility="Collapsed">
                            <TextBlock Text="No modules yet" Style="{StaticResource MutedText}"/>
                            <Button Content="Add modules in Grades" Click="OpenGrades_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>    </Grid>
</UserControl>

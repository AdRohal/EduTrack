<UserControl x:Class="EduTrack.View.ClassAttendance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:EduTrack.Utilities">
    <UserControl.Resources>
        <!-- Segmented choice: Present / Absent / Late / Excused -->
        <Style x:Key="Seg" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="4,7" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Margin="-1,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A lesson of the day -->
        <Style x:Key="SessionItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Mode" TargetType="RadioButton" BasedOn="{StaticResource TabButton}">
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Date, lessons, and which view -->
        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="DayNav" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Click="PrevDay_Click" ToolTip="Previous day" Width="34" Height="34" MinHeight="34">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconBack}"/>
                        </Button>
                        <DatePicker x:Name="DayPicker" Width="170" SelectedDateChanged="DayPicker_SelectedDateChanged" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Click="NextDay_Click" ToolTip="Next day" Width="34" Height="34" MinHeight="34">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconBack}" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><ScaleTransform ScaleX="-1"/></Path.RenderTransform>
                            </Path>
                        </Button>
                        <Button Content="Today" Click="Today_Click" Margin="8,0,0,0" MinHeight="34"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="ModeRollCall" Content="Roll call" Style="{StaticResource Mode}" GroupName="AttMode" IsChecked="True" Checked="Mode_Changed"/>
                        <RadioButton x:Name="ModeReport" Content="Report" Style="{StaticResource Mode}" GroupName="AttMode" Margin="0" Checked="Mode_Changed"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="LessonStrip" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="SessionList" ItemContainerStyle="{StaticResource SessionItem}" SelectionChanged="SessionList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TimeText}" FontWeight="Bold" FlowDirection="LeftToRight"/>
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconCheck}" Width="16" Height="16" Margin="8,2,0,0"
                                              TextElement.Foreground="{DynamicResource SuccessBrush}" Visibility="{Binding TakenVisibility}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Column="1" Content="Extra lesson" Click="ExtraLesson_Click" VerticalAlignment="Top" MinHeight="40"/>
                </Grid>

                <!-- Extra lesson, done inline -->
                <Border x:Name="ExtraPanel" Visibility="Collapsed" Margin="0,4,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="From" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ExtraStart"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="To" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ExtraEnd"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="Title" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ExtraTitle" MaxLength="100" Tag="e.g. Revision session"/></StackPanel>
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Cancel" Click="ExtraCancel_Click" Margin="0,0,8,0"/>
                            <Button Content="Add lesson" Style="{StaticResource PrimaryButton}" Click="ExtraAdd_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Roll call -->
        <Border x:Name="RollCall" Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="20,12,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CountPresent" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" Margin="0,0,16,0"/>
                            <TextBlock x:Name="CountAbsent" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" Margin="0,0,16,0"/>
                            <TextBlock x:Name="CountLate" Foreground="{DynamicResource LateBrush}" FontWeight="Bold" Margin="0,0,16,0"/>
                            <TextBlock x:Name="CountExcused" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock x:Name="SaveState" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ClearButton" Content="Delete record" Click="ClearRecord_Click" Style="{StaticResource GhostButton}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <Button Content="Mark all present" Click="AllPresent_Click" Margin="0,0,8,0"/>
                        <Button x:Name="SaveButton" Content="Save attendance" Style="{StaticResource PrimaryButton}" Click="Save_Click" MinWidth="150"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <ListBox x:Name="RowsList" PreviewKeyDown="RowsList_PreviewKeyDown" Margin="8,0,8,8" KeyboardNavigation.DirectionalNavigation="Continue">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" FontWeight="Bold" Margin="12,12,0,4"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="110" MaxWidth="260"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <u:Avatar Photo="{Binding P_Pic}" Initials="{Binding Initials}" Width="34" Height="34"/>
                                        <TextBlock Text="{Binding FullName}" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                    </StackPanel>
                                    <UniformGrid Grid.Column="1" Columns="4" Width="304" Margin="8,0">
                                        <ToggleButton Content="Present" Style="{StaticResource Seg}" Tag="{DynamicResource SuccessBrush}" IsChecked="{Binding IsPresent, Mode=TwoWay}" ToolTip="Present  (P)"/>
                                        <ToggleButton Content="Absent" Style="{StaticResource Seg}" Tag="{DynamicResource DangerBrush}" IsChecked="{Binding IsAbsent, Mode=TwoWay}" ToolTip="Absent  (A)"/>
                                        <ToggleButton Content="Late" Style="{StaticResource Seg}" Tag="{DynamicResource LateBrush}" IsChecked="{Binding IsLate, Mode=TwoWay}" ToolTip="Late  (L)"/>
                                        <ToggleButton Content="Excused" Style="{StaticResource Seg}" Tag="{DynamicResource PrimaryBrush}" IsChecked="{Binding IsExcused, Mode=TwoWay}" ToolTip="Excused  (E)"/>
                                    </UniformGrid>
                                    <TextBox Grid.Column="2" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" MinHeight="34" Tag="Note" Visibility="{Binding NoteVisibility}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="NoLesson" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400" Visibility="Collapsed">
                        <TextBlock x:Name="NoLessonTitle" Text="No lesson on this day" Style="{StaticResource SectionText}" TextAlignment="Center"/>
                        <TextBlock x:Name="NoLessonText" Text="Plan lessons in the Timetable, or add an extra lesson for this day." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Report -->
        <Border x:Name="Report" Grid.Row="1" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="20,12,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="ReportStudents" Content="Students" Style="{StaticResource Mode}" GroupName="RepWho" IsChecked="True" Checked="ReportFilter_Changed"/>
                        <RadioButton x:Name="ReportTeachers" Content="Teachers" Style="{StaticResource Mode}" GroupName="RepWho" Checked="ReportFilter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="From" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker x:Name="FromPicker" Width="150" SelectedDateChanged="ReportRange_Changed"/>
                        <TextBlock Text="To" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="14,0,8,0"/>
                        <DatePicker x:Name="ToPicker" Width="150" SelectedDateChanged="ReportRange_Changed"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <DataGrid x:Name="ReportGrid" BorderThickness="0" Background="Transparent" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Name" Width="3*" SortMemberPath="FullName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,2">
                                            <u:Avatar Photo="{Binding P_Pic}" Initials="{Binding Initials}" Width="30" Height="30"/>
                                            <TextBlock Text="{Binding FullName}" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Present" Binding="{Binding Present}" Width="*"/>
                            <DataGridTextColumn Header="Late" Binding="{Binding Late}" Width="*"/>
                            <DataGridTextColumn Header="Absent" Binding="{Binding Absent}" Width="*"/>
                            <DataGridTextColumn Header="Excused" Binding="{Binding Excused}" Width="*"/>
                            <DataGridTextColumn Header="Rate" Binding="{Binding RateText}" SortMemberPath="Rate" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="ReportEmpty" Text="No attendance has been recorded in this period." Style="{StaticResource MutedText}" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="EduTrack.View.DetailedEmployeeInfoView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,8">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <Button Click="Back_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-12,0,0,6" ToolTip="Back to the list">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource IconBack}"/><TextBlock Text="Back to employees" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                </Button>
                <TextBlock Text="Employee details" Style="{StaticResource DisplayText}"/>
                <TextBlock Text="Edit anything below, then choose Save changes." Style="{StaticResource MutedText}" Margin="0,4,0,20"/>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,32,0" Width="140">
                    <Grid Width="128" Height="128" HorizontalAlignment="Center">
                        <Ellipse Fill="{DynamicResource PrimarySoftBrush}"/>
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconUser}" TextElement.Foreground="{DynamicResource PrimaryBrush}" Margin="52,52,0,0"/>
                        <Image x:Name="uploadedImage" Stretch="UniformToFill">
                            <Image.Clip><EllipseGeometry RadiusX="64" RadiusY="64" Center="64,64"/></Image.Clip>
                        </Image>
                        <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="1"/>
                    </Grid>
                    <Button x:Name="ProfilePicture" Content="Choose photo" Click="Button_Click_1" Margin="0,14,0,0"/>
                    <TextBlock Text="JPG or PNG" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Personal information" Style="{StaticResource SectionText}"/>
                    <TextBlock Text="Fields marked with * are required." Style="{StaticResource CaptionText}" Margin="0,2,0,18"/>
            <Grid Margin="0,0,-16,-16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,16,16">
                    <TextBlock Text="First name *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtFirstName"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,16,16">
                    <TextBlock Text="Middle name" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtMiddleName"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2" Margin="0,0,16,16">
                    <TextBlock Text="Last name *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtLastName"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,16,16">
                    <TextBlock Text="Gender" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="comboBoxGender" ItemsSource="{StaticResource GenderList}" Tag="Select"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,16,16">
                    <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtEmail" Tag="name@example.com"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Margin="0,0,16,16">
                    <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtPhone" Tag="+212 6 00 00 00 00"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,16,16">
                    <TextBlock Text="Date of birth" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="datePickerBirthDate"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,16,16">
                    <TextBlock Text="Nationality" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="comboBoxNationality" ItemsSource="{StaticResource CountryList}" Tag="Select"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" Margin="0,0,16,16">
                    <TextBlock Text="ID card (CIN)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtCin"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="6" Margin="0,0,16,16">
                    <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtAddress"/>
                </StackPanel>
            </Grid>
                </StackPanel>
            </Grid>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Professional details" Style="{StaticResource SectionText}"/>
                <Rectangle Height="16"/>
            <Grid Margin="0,0,-16,-16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,16,16">
                    <TextBlock Text="Organization" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtOrganization"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" Margin="0,0,16,16">
                    <TextBlock Text="Role" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtRole"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,16,16">
                    <TextBlock Text="Date of appointment" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="Date_appointment"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Margin="0,0,16,16">
                    <TextBlock Text="Experience" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="Exp_years" IsReadOnly="True" Tag="Calculated from the appointment date"/>
                </StackPanel>
            </Grid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Contract" Style="{StaticResource SectionText}"/>
                <Rectangle Height="16"/>
            <Grid Margin="0,0,-16,-16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,16,16">
                    <TextBlock Text="Contract start" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="contract_start"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,16,16">
                    <TextBlock Text="Contract end" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="contract_end"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2" Margin="0,0,16,16">
                    <TextBlock Text="Duration" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="contract_years" IsReadOnly="True" Tag="Calculated"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,16,16">
                    <TextBlock Text="Salary (MAD per month)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtSalary"/>
                </StackPanel>
            </Grid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Education" Style="{StaticResource SectionText}"/>
                <Rectangle Height="16"/>
            <Grid Margin="0,0,-16,-16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,16,16">
                    <TextBlock Text="Highest degree" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtHighestDegree"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,16,16">
                    <TextBlock Text="Graduation year" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtYearGraduation" Tag="2015"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2" Margin="0,0,16,16">
                    <TextBlock Text="University" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtUniversity"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Margin="0,0,16,16">
                    <TextBlock Text="Specialization" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtSpecialization"/>
                </StackPanel>
            </Grid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Documents" Style="{StaticResource SectionText}"/>
                <TextBlock Text="Scans or photos. Open any of them from here later." Style="{StaticResource CaptionText}" Margin="0,2,0,18"/>
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconDocument}" TextElement.Foreground="{DynamicResource PrimaryBrush}" Margin="8,8,0,0"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="ID card, front" FontWeight="Bold"/>
                        <Label x:Name="FileNameLabel" Content="No file chosen" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <Button x:Name="UploadButton" Grid.Column="2" Content="Choose file" Click="UploadDocument_Click"/>
                    <Button x:Name="ViewButton" Grid.Column="3" Style="{StaticResource IconButton}" Margin="8,0,0,0" ToolTip="Open the file" Visibility="Visible" Click="ViewDocument_Click">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconEye}"/>
                    </Button>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconDocument}" TextElement.Foreground="{DynamicResource PrimaryBrush}" Margin="8,8,0,0"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="ID card, back" FontWeight="Bold"/>
                        <Label x:Name="FileNameLabel2" Content="No file chosen" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <Button x:Name="UploadButton2" Grid.Column="2" Content="Choose file" Click="UploadDocument_Click2"/>
                    <Button x:Name="ViewButton2" Grid.Column="3" Style="{StaticResource IconButton}" Margin="8,0,0,0" ToolTip="Open the file" Visibility="Visible" Click="ViewDocument_Click2">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconEye}"/>
                    </Button>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconDocument}" TextElement.Foreground="{DynamicResource PrimaryBrush}" Margin="8,8,0,0"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="Contract" FontWeight="Bold"/>
                        <Label x:Name="FileNameLabel3" Content="No file chosen" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <Button x:Name="UploadButton3" Grid.Column="2" Content="Choose file" Click="UploadDocument_Click3"/>
                    <Button x:Name="ViewButton3" Grid.Column="3" Style="{StaticResource IconButton}" Margin="8,0,0,0" ToolTip="Open the file" Visibility="Visible" Click="ViewDocument_Click3">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconEye}"/>
                    </Button>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconDocument}" TextElement.Foreground="{DynamicResource PrimaryBrush}" Margin="8,8,0,0"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="Resume" FontWeight="Bold"/>
                        <Label x:Name="FileNameLabel4" Content="No file chosen" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <Button x:Name="UploadButton4" Grid.Column="2" Content="Choose file" Click="UploadDocument_Click4"/>
                    <Button x:Name="ViewButton4" Grid.Column="3" Style="{StaticResource IconButton}" Margin="8,0,0,0" ToolTip="Open the file" Visibility="Visible" Click="ViewDocument_Click4">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconEye}"/>
                    </Button>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconDocument}" TextElement.Foreground="{DynamicResource PrimaryBrush}" Margin="8,8,0,0"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="Diploma" FontWeight="Bold"/>
                        <Label x:Name="FileNameLabel5" Content="No file chosen" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <Button x:Name="UploadButton5" Grid.Column="2" Content="Choose file" Click="UploadDocument_Click5"/>
                    <Button x:Name="ViewButton5" Grid.Column="3" Style="{StaticResource IconButton}" Margin="8,0,0,0" ToolTip="Open the file" Visibility="Visible" Click="ViewDocument_Click5">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconEye}"/>
                    </Button>
                </Grid>
            </StackPanel>
            </StackPanel>
        </Border>
            </StackPanel></Grid>
        </ScrollViewer>
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="Delete employee" Click="Button_Click2" Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" Margin="0,0,16,0"/>
            <TextBlock x:Name="FormError" Grid.Column="1" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="2" Content="Save changes" Style="{StaticResource PrimaryButton}" Click="Button_Click" MinWidth="150" Height="42"/>
        </Grid>
    </Border>
    </Grid>
</UserControl>

<UserControl x:Class="EduTrack.View.ShowStudents"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:EduTrack.Utilities">
    <UserControl.Resources>
        <u:DashIfEmptyConverter x:Key="Dash"/>
        <u:ShortDateConverter x:Key="ShortDate"/>
        <u:NotNullConverter x:Key="NotNull"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="400"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" Padding="40,0,12,0" Tag="Search by first, middle or last name" TextChanged="SearchBox_TextChanged"/>
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconSearch}" TextElement.Foreground="{DynamicResource FaintBrush}"
                      Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock x:Name="CountText" Grid.Column="1" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="Refresh_Click" ToolTip="Reload the list" Margin="0,0,8,0">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconRefresh}"/>
            </Button>
            <Button Grid.Column="3" Content="Open details" Style="{StaticResource PrimaryButton}" Click="Button_Click1"
                    IsEnabled="{Binding SelectedItem, ElementName=StudentsList, Converter={StaticResource NotNull}}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="StudentsList" BorderThickness="0" Background="Transparent" IsReadOnly="True"
                          MouseDoubleClick="StudentsList_MouseDoubleClick" KeyDown="StudentsList_KeyDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Student" Width="2.4*" SortMemberPath="FullName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <u:Avatar Photo="{Binding P_Pic}" Initials="{Binding Initials}" Width="38" Height="38"/>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Email, Converter={StaticResource Dash}}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Major" Width="1.6*" Binding="{Binding Major, Converter={StaticResource Dash}}"/>
                        <DataGridTextColumn Header="Phone" Width="1.3*" Binding="{Binding Phone, Converter={StaticResource Dash}}"/>
                        <DataGridTextColumn Header="ID card (CIN)" Width="1.2*" Binding="{Binding CIN, Converter={StaticResource Dash}}"/>
                        <DataGridTextColumn Header="Joined" Width="1.1*" SortMemberPath="J_Date" Binding="{Binding J_Date, Converter={StaticResource ShortDate}}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="380">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource PrimarySoftBrush}" HorizontalAlignment="Center">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconStudent}" TextElement.Foreground="{DynamicResource PrimaryBrush}" Margin="20,20,0,0"/>
                    </Border>
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource SectionText}" TextAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="EmptyHint" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0"/>
                    <Button x:Name="EmptyAction" Content="Add the first student" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                            Margin="0,18,0,0" Click="EmptyAction_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

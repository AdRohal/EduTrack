<UserControl x:Class="EduTrack.View.ClassesGrades"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:EduTrack.Utilities">
    <UserControl.Resources>
        <u:ZeroToVisibleConverter x:Key="ZeroToVisible"/>
        <Style x:Key="GradeEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="-6,0"/>
            <Setter Property="MaxLength" Value="10"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Class" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="classesComboBox" Tag="Choose a class" SelectionChanged="classesComboBox_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Module" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ModuleComboBox" Tag="Choose a module" SelectionChanged="ModuleComboBox_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <StackPanel Width="230">
                        <TextBlock Text="Add a module to this class" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="moduleNameTextBox" Tag="e.g. Algebra"/>
                    </StackPanel>
                    <Button x:Name="addModuleButton" Content="Add module" Click="AddModuleButton_Click" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="studentsDataGrid" BorderThickness="0" Background="Transparent" ItemsSource="{Binding}" IsReadOnly="False" SelectionUnit="Cell">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Student" Binding="{Binding FullName}" Width="3*" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Grade" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Grade}" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Grade, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GradeEditor}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" IsHitTestVisible="False"
                            Visibility="{Binding Items.Count, ElementName=studentsDataGrid, Converter={StaticResource ZeroToVisible}}">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource PrimarySoftBrush}" HorizontalAlignment="Center">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconChart}" TextElement.Foreground="{DynamicResource PrimaryBrush}" Margin="20,20,0,0"/>
                    </Border>
                    <TextBlock x:Name="EmptyTitle" Text="No grades to enter yet" Style="{StaticResource SectionText}" TextAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock x:Name="EmptyText" Text="Choose a class and a module above. The students of that class appear here, ready for their grades." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Button x:Name="saveGradeButton" Grid.Row="2" Content="Save grades" Style="{StaticResource PrimaryButton}" Click="SaveGradeButton_Click"
                HorizontalAlignment="Right" Margin="0,16,0,0" MinWidth="150" Height="42"/>
    </Grid>
</UserControl>

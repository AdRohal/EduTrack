<UserControl x:Class="EduTrack.View.Students"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Students" Style="{StaticResource DisplayText}"/>
            <TextBlock Text="Everyone enrolled, with their contact details and documents." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabList" Content="All students" Style="{StaticResource TabButton}" GroupName="StudentTabs" Margin="0,0,28,-1" Checked="Btn_Checked_1" Click="TabList_Click"/>
                    <RadioButton x:Name="TabNew" Content="New student" Style="{StaticResource TabButton}" GroupName="StudentTabs" Margin="0,0,28,-1" Checked="Btn_Checked" Click="TabNew_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <ContentControl x:Name="Pages" Grid.Row="1" Margin="0,20,0,0" IsTabStop="False"/>
    </Grid>
</UserControl>

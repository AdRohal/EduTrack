<UserControl x:Class="EduTrack.View.ClassesSchedule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:EduTrack.Utilities">
    <UserControl.Resources>
        <u:ZeroToVisibleConverter x:Key="ZeroToVisible"/>

        <Style x:Key="TimetableCell" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEditing" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TimeCell" TargetType="DataGridCell" BasedOn="{StaticResource TimetableCell}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CellEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="-6,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Width="300">
                <TextBlock Text="Class" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="comboBoxClass" Tag="Choose a class" SelectionChanged="ClassComboBox_SelectionChanged"/>
            </StackPanel>
            <TextBlock x:Name="HintText" Grid.Column="1" Style="{StaticResource MutedText}" VerticalAlignment="Bottom" Margin="20,0,0,10"
                       Text="Click a cell and type the subject or room. Tab moves to the next day."/>
            <TextBlock x:Name="DirtyText" Grid.Column="2" Text="Unsaved changes" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Bottom" Margin="0,0,16,11" Visibility="Collapsed"/>
            <Button x:Name="SaveBtn" Grid.Column="3" Content="Save schedule" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" VerticalAlignment="Bottom" IsEnabled="False"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="scheduleDataGrid" BorderThickness="0" Background="Transparent" SelectionUnit="Cell" CanUserSortColumns="False"
                          CanUserReorderColumns="False" CellEditEnding="scheduleDataGrid_CellEditEnding" ColumnWidth="*" RowHeight="46">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding TimeSlot}" Width="120" IsReadOnly="True" CellStyle="{StaticResource TimeCell}"/>
                        <DataGridTextColumn Header="Monday" Binding="{Binding Monday}" MinWidth="100" Width="*" CellStyle="{StaticResource TimetableCell}" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}"/>
                        <DataGridTextColumn Header="Tuesday" Binding="{Binding Tuesday}" Width="*" CellStyle="{StaticResource TimetableCell}" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}"/>
                        <DataGridTextColumn Header="Wednesday" Binding="{Binding Wednesday}" Width="*" CellStyle="{StaticResource TimetableCell}" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}"/>
                        <DataGridTextColumn Header="Thursday" Binding="{Binding Thursday}" Width="*" CellStyle="{StaticResource TimetableCell}" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}"/>
                        <DataGridTextColumn Header="Friday" Binding="{Binding Friday}" Width="*" CellStyle="{StaticResource TimetableCell}" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}"/>
                        <DataGridTextColumn Header="Saturday" Binding="{Binding Saturday}" Width="*" CellStyle="{StaticResource TimetableCell}" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}"/>
                        <DataGridTextColumn Header="Sunday" Binding="{Binding Sunday}" Width="*" CellStyle="{StaticResource TimetableCell}" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="360" Background="{DynamicResource SurfaceBrush}">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource PrimarySoftBrush}" HorizontalAlignment="Center">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconCalendar}" TextElement.Foreground="{DynamicResource PrimaryBrush}" Margin="20,20,0,0"/>
                    </Border>
                    <TextBlock Text="No classes to schedule yet" Style="{StaticResource SectionText}" TextAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock Text="Create a class first, then plan its week here." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

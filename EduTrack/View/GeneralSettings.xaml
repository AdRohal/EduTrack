<UserControl x:Class="EduTrack.View.GeneralSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ThemeTile" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Width="230" Padding="12" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource LineBrush}"
                                Background="{DynamicResource SurfaceBrush}">
                            <StackPanel>
                                <ContentPresenter Content="{TemplateBinding Tag}"/>
                                <Grid Margin="0,12,0,0">
                                    <TextBlock Text="{TemplateBinding Content}" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                    <Path x:Name="Tick" FlowDirection="LeftToRight" Style="{StaticResource Icon}" Data="{StaticResource IconCheck}" TextElement.Foreground="{DynamicResource PrimaryBrush}"
                                          HorizontalAlignment="Right" Visibility="Collapsed" Margin="0,-2,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FaintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,8">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1000*" MaxWidth="900"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Theme" Style="{StaticResource SectionText}"/>
                    <TextBlock Text="Classic is the original EduTrack look. Paper and Slate are the green alternatives. EduTrack remembers your choice." Style="{StaticResource MutedText}" Margin="0,4,0,18"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ClassicTile" Content="Classic (original)" Style="{StaticResource ThemeTile}" GroupName="Theme" Checked="Classic_Checked">
                            <RadioButton.Tag>
                                <Border Height="96" CornerRadius="8" Background="#212529" BorderBrush="#3E434A" BorderThickness="1">
                                    <Grid>
                                        <Border Width="44" HorizontalAlignment="Left" Background="#2B2F30" CornerRadius="7,0,0,7"/>
                                        <StackPanel Margin="58,14,14,0">
                                            <Border Height="10" Width="90" HorizontalAlignment="Left" CornerRadius="3" Background="#10CCFC"/>
                                            <Border Height="30" Margin="0,12,0,0" CornerRadius="5" Background="#272B2F" BorderBrush="#3E434A" BorderThickness="1"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </RadioButton.Tag>
                        </RadioButton>
                        <RadioButton x:Name="PaperTile" Content="Paper (light green)" Style="{StaticResource ThemeTile}" GroupName="Theme" Checked="Paper_Checked">
                            <RadioButton.Tag>
                                <Border Height="96" CornerRadius="8" Background="#F1F4F1" BorderBrush="#DDE4DF" BorderThickness="1">
                                    <Grid>
                                        <Border Width="44" HorizontalAlignment="Left" Background="#13302A" CornerRadius="7,0,0,7"/>
                                        <StackPanel Margin="58,14,14,0">
                                            <Border Height="10" Width="90" HorizontalAlignment="Left" CornerRadius="3" Background="#16201D"/>
                                            <Border Height="30" Margin="0,12,0,0" CornerRadius="5" Background="White" BorderBrush="#DDE4DF" BorderThickness="1"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </RadioButton.Tag>
                        </RadioButton>
                        <RadioButton x:Name="SlateTile" Content="Slate (dark green)" Style="{StaticResource ThemeTile}" GroupName="Theme" Checked="Slate_Checked">
                            <RadioButton.Tag>
                                <Border Height="96" CornerRadius="8" Background="#0E1513" BorderBrush="#2A3A35" BorderThickness="1">
                                    <Grid>
                                        <Border Width="44" HorizontalAlignment="Left" Background="#0A100E" CornerRadius="7,0,0,7"/>
                                        <StackPanel Margin="58,14,14,0">
                                            <Border Height="10" Width="90" HorizontalAlignment="Left" CornerRadius="3" Background="#E8EFEB"/>
                                            <Border Height="30" Margin="0,12,0,0" CornerRadius="5" Background="#16201D" BorderBrush="#2A3A35" BorderThickness="1"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </RadioButton.Tag>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Language" Style="{StaticResource SectionText}"/>
                        <TextBlock Text="Choose the language of the whole app. EduTrack remembers your choice." Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox x:Name="LanguageBox" Grid.Column="1" Width="240" VerticalAlignment="Center" SelectionChanged="Language_Changed">
                        <ComboBoxItem Tag="en" Content="English"/>
                        <ComboBoxItem Tag="fr" Content="Français"/>
                        <ComboBoxItem Tag="es" Content="Español"/>
                        <ComboBoxItem Tag="ar" Content="العربية"/>
                        <ComboBoxItem Tag="id" Content="Bahasa Indonesia"/>
                        <ComboBoxItem Tag="zh" Content="中文（简体）"/>
                        <ComboBoxItem Tag="ja" Content="日本語"/>
                        <ComboBoxItem Tag="ko" Content="한국어"/>
                    </ComboBox>
                </Grid>
            </Border>
        </StackPanel></Grid>
    </ScrollViewer>
</UserControl>

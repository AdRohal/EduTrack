<UserControl x:Class="EduTrack.View.DocumentViewerOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="True" WindowChrome.IsHitTestVisibleInChrome="True">
    <Grid Background="#F2090C12">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="24,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel x:Name="PagePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,18,0">
                    <Button Style="{StaticResource IconButton}" Foreground="White" Click="PrevPage_Click" ToolTip="Previous page">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconBack}"/>
                    </Button>
                    <TextBlock x:Name="PageText" Foreground="White" MinWidth="64" TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" Foreground="White" Click="NextPage_Click" ToolTip="Next page">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconBack}" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><ScaleTransform ScaleX="-1"/></Path.RenderTransform>
                        </Path>
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Foreground="White" Click="ZoomOut_Click" ToolTip="Zoom out  (-)">
                    <Path Style="{StaticResource Icon}" Data="M6,12 H18"/>
                </Button>
                <TextBlock x:Name="ZoomText" Foreground="White" Width="56" TextAlignment="Center" VerticalAlignment="Center" Text="100%"/>
                <Button Style="{StaticResource IconButton}" Foreground="White" Click="ZoomIn_Click" ToolTip="Zoom in  (+)">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlus}"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Foreground="White" Click="Fit_Click" Margin="6,0,0,0" ToolTip="Fit to screen  (0 or double-click)">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconMaximize}"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Foreground="White" Click="Close_Click" Margin="14,0,0,0" ToolTip="Close  (Esc)">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Image area: wheel zooms toward the cursor, drag moves the picture -->
        <Border x:Name="Viewport" Grid.Row="1" Background="Transparent" ClipToBounds="True" Cursor="Hand"
                SizeChanged="Viewport_SizeChanged" MouseWheel="Viewport_MouseWheel"
                MouseLeftButtonDown="Viewport_MouseDown" MouseLeftButtonUp="Viewport_MouseUp" MouseMove="Viewport_MouseMove">
            <Canvas>
                <Image x:Name="Picture" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="Scale"/>
                            <TranslateTransform x:Name="Move"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Canvas>
        </Border>
    </Grid>
</UserControl>

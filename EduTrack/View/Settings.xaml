<UserControl x:Class="EduTrack.View.Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource DisplayText}"/>
            <TextBlock Text="How EduTrack looks, and how to keep a copy of your data." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabAppearance" Content="Appearance" Style="{StaticResource TabButton}" GroupName="SettingsTabs" Margin="0,0,28,-1" Checked="Btn_Checked"/>
                    <RadioButton x:Name="TabBackup" Content="Backup and restore" Style="{StaticResource TabButton}" GroupName="SettingsTabs" Margin="0,0,28,-1" Checked="Btn_Checked_1"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <ContentControl x:Name="Pages" Grid.Row="1" Margin="0,24,0,0" IsTabStop="False"/>
    </Grid>
</UserControl>

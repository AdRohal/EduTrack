<UserControl x:Class="EduTrack.View.ShowClasses"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:EduTrack.Utilities">
    <UserControl.Resources>
        <u:DashIfEmptyConverter x:Key="Dash"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Class picker and adding people -->
        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Width="300">
                        <TextBlock Text="Class" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="comboBoxClass" DisplayMemberPath="ClassName" Tag="Choose a class" SelectionChanged="comboBoxClass_SelectionChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="ClassMeta" Grid.Column="1" Style="{StaticResource MutedText}" VerticalAlignment="Bottom" Margin="20,0,0,10"/>
                    <Button x:Name="deleteButton" Grid.Column="2" Content="Delete class" Click="deleteButton_Click" VerticalAlignment="Bottom"
                            Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" IsEnabled="False"/>
                </Grid>

                <StackPanel x:Name="AddPanel" Grid.Row="1" Margin="0,16,0,0" IsEnabled="False">
                    <Rectangle Height="1" Fill="{DynamicResource LineBrush}" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MaxWidth="420"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Add to this class" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="radioStudent" Content="A student" IsChecked="True" Style="{StaticResource TabButton}" GroupName="AddKind" Margin="0,0,20,0" Checked="AddKind_Changed"/>
                                <RadioButton x:Name="radioTeacher" Content="A teacher" Style="{StaticResource TabButton}" GroupName="AddKind" Margin="0,0,24,0" Checked="AddKind_Changed"/>
                            </StackPanel>
                        </StackPanel>
                        <ComboBox x:Name="comboBoxTeacherStudent" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,12,2" Tag="Choose who to add">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Text="{Binding Note}" Foreground="{DynamicResource FaintBrush}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2" Content="Add to class" Style="{StaticResource PrimaryButton}" Click="AddTeacherOrStudent_Click" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rosters -->
        <Grid Grid.Row="1">
            <Grid x:Name="RosterGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="520"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock x:Name="TeachersHeader" Text="Teachers" Style="{StaticResource SectionText}" Margin="20,16,20,12"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <ItemsControl x:Name="TeachersList" Margin="8,0,8,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Margin="12,8">
                                                    <u:Avatar Photo="{Binding P_Pic}" Initials="{Binding Initials}" Width="38" Height="38"/>
                                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FullName}" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Email, Converter={StaticResource Dash}}" Style="{StaticResource CaptionText}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="RemoveTeacher_Click" ToolTip="Remove from this class" Margin="0,0,8,0">
                                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="TeachersEmpty" Text="No teacher has been assigned to this class yet." Style="{StaticResource MutedText}"
                                           Margin="20,4,20,0" Visibility="Collapsed"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="20,16,20,12">
                            <TextBlock x:Name="StudentsHeader" Text="Students" Style="{StaticResource SectionText}" VerticalAlignment="Center"/>
                            <Grid HorizontalAlignment="Right" Width="260">
                                <TextBox x:Name="SearchBox" Padding="38,0,12,0" Tag="Search this class" TextChanged="SearchBox_TextChanged" MinHeight="34"/>
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconSearch}" TextElement.Foreground="{DynamicResource FaintBrush}" Margin="11,0,0,0"
                                      VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <ItemsControl x:Name="StudentsList" Margin="8,0,8,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Margin="12,8">
                                                    <u:Avatar Photo="{Binding P_Pic}" Initials="{Binding Initials}" Width="38" Height="38"/>
                                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FullName}" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Email, Converter={StaticResource Dash}}" Style="{StaticResource CaptionText}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="RemoveStudent_Click" ToolTip="Remove from this class" Margin="0,0,8,0">
                                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="StudentsEmpty" Text="No student is in this class yet. Use the Add to class bar above." Style="{StaticResource MutedText}"
                                           Margin="20,4,20,0" Visibility="Collapsed"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Nothing chosen yet / no classes -->
            <StackPanel x:Name="IdleState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource PrimarySoftBrush}" HorizontalAlignment="Center">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconClass}" TextElement.Foreground="{DynamicResource PrimaryBrush}" Margin="20,20,0,0"/>
                </Border>
                <TextBlock x:Name="IdleTitle" Style="{StaticResource SectionText}" TextAlignment="Center" Margin="0,16,0,0" Text="Choose a class"/>
                <TextBlock x:Name="IdleHint" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0" Text="Pick a class above to see its teachers and students."/>
                <Button x:Name="IdleAction" Content="Create the first class" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0"
                        Click="IdleAction_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="EduTrack.View.Backup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,8">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1000*" MaxWidth="900"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Save a copy" Style="{StaticResource SectionText}"/>
                    <TextBlock Text="Export one list to an XML file you can keep safe or move to another computer." Style="{StaticResource MutedText}" Margin="0,4,0,18"/>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="260">
                            <TextBlock Text="What to save" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="comboBox1" SelectedIndex="0">
                                <ComboBoxItem Content="Students"/>
                                <ComboBoxItem Content="Teachers"/>
                                <ComboBoxItem Content="Employees"/>
                            </ComboBox>
                        </StackPanel>
                        <Button x:Name="downloadButton" Content="Save to file" Style="{StaticResource PrimaryButton}" Click="downloadButton_Click"
                                VerticalAlignment="Bottom" Margin="14,0,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="ExportResult" Orientation="Horizontal" Margin="0,16,0,0" Visibility="Collapsed">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconCheck}" TextElement.Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock x:Name="ExportResultText" VerticalAlignment="Center" Margin="8,0,12,0" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"/>
                        <Button Content="Show in folder" Click="ShowFolder_Click" MinHeight="32" Padding="12,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Restore from a copy" Style="{StaticResource SectionText}"/>
                    <TextBlock Text="Choose a file saved above. Records with the same ID are replaced by the ones in the file." Style="{StaticResource MutedText}" Margin="0,4,0,18"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="uploadButton" Content="Choose file" Click="uploadButton_Click"/>
                        <TextBlock x:Name="fileNameTextBlock" Text="No file chosen" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,20,0"/>
                        <Button x:Name="importButton" Content="Restore data" Style="{StaticResource PrimaryButton}" Click="importButton_Click" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel></Grid>
    </ScrollViewer>
</UserControl>

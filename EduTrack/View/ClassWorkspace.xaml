<UserControl x:Class="EduTrack.View.ClassWorkspace" SizeChanged="Workspace_SizeChanged"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:EduTrack.Utilities">
    <UserControl.Resources>
        <!-- One row of the class list -->
        <DataTemplate x:Key="ClassRow">
            <StackPanel Margin="12,9">
                <TextBlock Text="{Binding ClassName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Major}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                <TextBlock Text="{Binding CountsText}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Classes" Style="{StaticResource DisplayText}"/>
                <ComboBox x:Name="ClassCombo" Width="250" Margin="22,0,0,0" VerticalAlignment="Center" DisplayMemberPath="ClassName" Visibility="Collapsed" SelectionChanged="ClassCombo_SelectionChanged"/>
            </StackPanel>
            <Button x:Name="NewClassButton" Grid.Column="1" Content="New class" Style="{StaticResource PrimaryButton}" Click="NewClass_Click" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="268"/>
                <ColumnDefinition x:Name="GapColumn" Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The classes: pick one and everything on the right is about it -->
            <Border x:Name="ListCard" Style="{StaticResource Card}" Padding="6">
                <Grid>
                    <ListBox x:Name="ClassList" ItemTemplate="{StaticResource ClassRow}" SelectionChanged="ClassList_SelectionChanged"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    <TextBlock x:Name="NoClassesText" Text="No class has been added yet. The one you save will appear here." Style="{StaticResource MutedText}"
                               Margin="14,12" Visibility="Collapsed" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- The chosen class -->
            <Grid Grid.Column="2" x:Name="Workspace" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ClassTitle" Style="{StaticResource TitleText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ClassMeta" Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Click="EditClass_Click" ToolTip="Edit class" Foreground="{DynamicResource MutedBrush}">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconEdit}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="DeleteClass_Click" ToolTip="Delete class" Foreground="{DynamicResource DangerBrush}">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconTrash}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="TabStrip" Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabOverview" Content="Overview" Tag="overview" Style="{StaticResource TabButton}" GroupName="ClassTabs" Margin="0,0,24,-1" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabPeople" Content="People" Tag="people" Style="{StaticResource TabButton}" GroupName="ClassTabs" Margin="0,0,24,-1" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabAttendance" Content="Attendance" Tag="attendance" Style="{StaticResource TabButton}" GroupName="ClassTabs" Margin="0,0,24,-1" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabGrades" Content="Grades" Tag="grades" Style="{StaticResource TabButton}" GroupName="ClassTabs" Margin="0,0,24,-1" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabTimetable" Content="Timetable" Tag="timetable" Style="{StaticResource TabButton}" GroupName="ClassTabs" Margin="0,0,0,-1" Checked="Tab_Checked"/>
                    </StackPanel>
                </Border>

                <ContentControl x:Name="TabContent" Grid.Row="2" Margin="0,16,0,0" IsTabStop="False"/>
            </Grid>

            <!-- No class yet -->
            <StackPanel x:Name="IdleState" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Visibility="Collapsed">
                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource PrimarySoftBrush}" HorizontalAlignment="Center">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconClass}" TextElement.Foreground="{DynamicResource PrimaryBrush}" Margin="20,20,0,0"/>
                </Border>
                <TextBlock Text="Create the first class" Style="{StaticResource SectionText}" TextAlignment="Center" Margin="0,16,0,0"/>
                <TextBlock Text="A class groups students, teachers, a weekly schedule and grades." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0"/>
                <Button Content="New class" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0" Click="NewClass_Click"/>
            </StackPanel>

            <!-- Create / edit form -->
            <ContentControl x:Name="FormHost" Grid.Column="2" IsTabStop="False" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>

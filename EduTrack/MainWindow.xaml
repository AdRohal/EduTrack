<Window Style="{StaticResource {x:Type Window}}" x:Class="EduTrack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:EduTrack.Utilities"
        xmlns:v="clr-namespace:EduTrack.View"
        Title="EduTrack" Width="1380" Height="840" MinWidth="1060" MinHeight="680"
        WindowStyle="None" WindowStartupLocation="CenterScreen" StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{DynamicResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="24,14,0,0" Height="40">
                    <u:LogoMark Width="34" Height="34" Foreground="{DynamicResource SidebarInkBrush}"/>
                    <TextBlock Text="EduTrack" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource SidebarInkBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="16,26,16,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" GroupName="Nav" Content="Home" Checked="Nav_Checked" ToolTip="Home  (Ctrl+1)">
                        <RadioButton.Tag><Path Style="{StaticResource Icon}" Data="{StaticResource IconHome}"/></RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="NavStudents" Style="{StaticResource NavButton}" GroupName="Nav" Content="Students" Checked="Nav_Checked" ToolTip="Students  (Ctrl+2)">
                        <RadioButton.Tag><Path Style="{StaticResource Icon}" Data="{StaticResource IconStudent}"/></RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="NavTeachers" Style="{StaticResource NavButton}" GroupName="Nav" Content="Teachers" Checked="Nav_Checked" ToolTip="Teachers  (Ctrl+3)">
                        <RadioButton.Tag><Path Style="{StaticResource Icon}" Data="{StaticResource IconTeacher}"/></RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="NavEmployees" Style="{StaticResource NavButton}" GroupName="Nav" Content="Employees" Checked="Nav_Checked" ToolTip="Employees  (Ctrl+4)">
                        <RadioButton.Tag><Path Style="{StaticResource Icon}" Data="{StaticResource IconEmployee}"/></RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="NavClasses" Style="{StaticResource NavButton}" GroupName="Nav" Content="Classes" Checked="Nav_Checked" ToolTip="Classes  (Ctrl+5)">
                        <RadioButton.Tag><Path Style="{StaticResource Icon}" Data="{StaticResource IconClass}"/></RadioButton.Tag>
                    </RadioButton>

                    <Rectangle Height="1" Fill="{DynamicResource SidebarLineBrush}" Margin="8,14,8,12"/>

                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav" Content="Settings" Checked="Nav_Checked" ToolTip="Settings  (Ctrl+6)">
                        <RadioButton.Tag><Path Style="{StaticResource Icon}" Data="{StaticResource IconSettings}"/></RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" GroupName="Nav" Content="About" Checked="Nav_Checked" ToolTip="About  (Ctrl+7)">
                        <RadioButton.Tag><Path Style="{StaticResource Icon}" Data="{StaticResource IconInfo}"/></RadioButton.Tag>
                    </RadioButton>
                </StackPanel>

                <!-- Signed-in user -->
                <Border Grid.Row="2" Margin="16,0,16,16" Padding="12" CornerRadius="12" Background="{DynamicResource SidebarHoverBrush}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentBrush}">
                            <TextBlock x:Name="AvatarInitial" Text="A" FontWeight="Bold" FontSize="16" Foreground="#13302A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameText" Text="Administrator" FontWeight="Bold" Foreground="{DynamicResource SidebarInkBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Administrator" FontSize="12" Foreground="{DynamicResource SidebarMutedBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="34" Height="34" MinHeight="34" Click="Theme_Click"
                                Foreground="{DynamicResource SidebarMutedBrush}" ToolTip="Change theme">
                            <Path x:Name="ThemeIcon" Style="{StaticResource Icon}" Data="{StaticResource IconMoon}"/>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="34" Height="34" MinHeight="34" Click="SignOut_Click"
                                Foreground="{DynamicResource SidebarMutedBrush}" ToolTip="Sign out">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconLogout}"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock x:Name="ClockTextBlock" Margin="36,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource WindowButton}" Click="MinimizeButton_Click" ToolTip="Minimize">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconMinimize}"/>
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource WindowButton}" Click="MaximizeButton_Click" ToolTip="Maximize">
                        <Path x:Name="MaxIcon" Style="{StaticResource Icon}" Data="{StaticResource IconMaximize}"/>
                    </Button>
                    <Button x:Name="CloseApp" Style="{StaticResource WindowCloseButton}" Click="CloseApp_Click" ToolTip="Close">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="Pages" Grid.Row="1" Margin="36,0,36,28" IsTabStop="False"/>
        </Grid>

        <!-- Document viewer: covers the whole app while a file is open -->
        <v:DocumentViewerOverlay x:Name="Viewer" Grid.ColumnSpan="2"/>
    </Grid>
</Window>

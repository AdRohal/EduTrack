<Window Style="{StaticResource {x:Type Window}}" x:Class="EduTrack.NextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:EduTrack.Utilities"
        Title="EduTrack - Sign in" Width="940" Height="600" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource SurfaceBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Chalkboard side: ruled like a school register -->
        <Grid>
            <Grid.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,100,34" ViewportUnits="Absolute" Viewbox="0,0,100,34" ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="{DynamicResource SidebarBrush}">
                                <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,34"/></GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Pen><Pen Brush="{DynamicResource SidebarLineBrush}" Thickness="1"/></GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry><LineGeometry StartPoint="0,33.5" EndPoint="100,33.5"/></GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Grid.Background>
            <!-- register margin line -->
            <Rectangle Width="1.5" HorizontalAlignment="Left" Margin="46,0,0,0" Fill="{DynamicResource AccentBrush}" Opacity="0.55"/>
            <StackPanel Margin="76,44,40,0" VerticalAlignment="Top" Orientation="Horizontal">
                <u:LogoMark Width="40" Height="40" Foreground="{DynamicResource SidebarInkBrush}"/>
                <TextBlock Text="EduTrack" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SidebarInkBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <StackPanel Margin="76,0,40,60" VerticalAlignment="Bottom">
                <TextBlock Text="One register for your whole school." FontSize="32" FontWeight="Bold" TextWrapping="Wrap" LineHeight="38"
                           Foreground="{DynamicResource SidebarInkBrush}"/>
                <TextBlock Text="Students, teachers, staff and classes, kept together and easy to find."
                           FontSize="15" TextWrapping="Wrap" LineHeight="22" Margin="0,16,0,0" Foreground="{DynamicResource SidebarMutedBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Form side -->
        <Grid Grid.Column="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="ThemeBtn" Style="{StaticResource WindowButton}" Click="Theme_Click" ToolTip="Change theme">
                    <Path x:Name="ThemeIcon" Style="{StaticResource Icon}" Data="{StaticResource IconMoon}" Width="24" Height="24"/>
                </Button>
                <Button Style="{StaticResource WindowCloseButton}" Click="CloseBtn_Click_1" ToolTip="Close">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"/>
                </Button>
            </StackPanel>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="330">
                <TextBlock x:Name="HeadingText" Text="Sign in" Style="{StaticResource DisplayText}"/>
                <TextBlock x:Name="SubText" Text="Use your administrator account to open the register." Style="{StaticResource MutedText}" Margin="0,8,0,26"/>

                <Border x:Name="ErrorBox" Background="{DynamicResource DangerSoftBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontWeight="Bold"/>
                </Border>

                <StackPanel x:Name="RememberedPanel" Visibility="Collapsed" Margin="0,0,0,18">
                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentBrush}">
                                <TextBlock x:Name="RememberedInitial" FontWeight="Bold" FontSize="20" Foreground="#13302A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="RememberedName" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="Signed in last time" Style="{StaticResource CaptionText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="UsernamePanel">
                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UserName" MaxLength="18" Tag="e.g. registrar" TextChanged="Field_Changed"/>
                </StackPanel>
<TextBlock x:Name="PasswordLabel" Text="Password" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                <PasswordBox x:Name="Password" PasswordChanged="Field_Changed"/>

                <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                    <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                    <PasswordBox x:Name="ConfirmPassword" PasswordChanged="Field_Changed"/>
                    <TextBlock Text="At least 6 characters." Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                </StackPanel>

                <Button x:Name="SubmitBtn" Content="Sign in" Style="{StaticResource PrimaryButton}" IsDefault="True" Height="44" Margin="0,24,0,0"
                        Click="Submit_Click" FontSize="15"/>

                <Button x:Name="OtherUserBtn" Content="Not you? Use another account" Style="{StaticResource GhostButton}" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed" Click="OtherUser_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock x:Name="SwitchPrompt" Text="First time here?" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    <Button x:Name="SwitchBtn" Content="Create an account" Style="{StaticResource GhostButton}" Foreground="{DynamicResource PrimaryBrush}"
                            Click="Switch_Click" MinHeight="32" Padding="8,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
